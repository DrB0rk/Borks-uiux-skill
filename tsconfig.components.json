{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "playground/dist"
  },
  "include": [
    "skills/b0rks-uiux/assets/components/*.ts",
    "playground/playground.ts"
  ],
  "exclude": [
    "node_modules",
    "playground/dist"
  ]
}
